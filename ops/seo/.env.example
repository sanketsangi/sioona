OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest
OPENSEO_PORT=3001
# Paid optional providers, never required by the free audit runner.
# DataForSEO expects base64(email:API-password), not an OAuth token.
DATAFORSEO_API_KEY=
OPENROUTER_API_KEY=
OPENSEO_TELEMETRY_DISABLED=true
# Blank = audit the mounted Next production build without Google requests.
# For local HTTP from Docker: http://host.docker.internal:3101
SEO_BASE_URL=
# Canonical production origin, even when crawling localhost. Never use a fake public origin.
SEO_CANONICAL_ORIGIN=
# Enable PageSpeed Insights and Chrome UX Report APIs; restrict key to these APIs.
GCP_API_KEY=
# Exact verified GSC property, e.g. sc-domain:your-domain or https://your-domain/
GSC_PROPERTY=
# Host execution only. Docker always reads ./secrets/gcp-service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional local Chromium lab audit of SEO_BASE_URL; runs sequentially.
SEO_LIGHTHOUSE=false
