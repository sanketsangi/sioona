    "test:smoke": "node scripts/verify-production.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^14.1.0",
