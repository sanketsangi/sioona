{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint src scripts next.config.ts && node scripts/check-tokens.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
