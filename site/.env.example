# Canonical origin used for metadataBase, sitemap and robots.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the "Sign In" link points (the product app). Leave unset to link to /contact.
NEXT_PUBLIC_APP_URL=

# Server-only durable pilot intake destination and matching backend service token.
PILOT_INTAKE_BACKEND_URL=
SIOONA_SERVICE_TOKEN=

# Approved public facts, rendered at build time. Rebuild after changing these.
# Use a monitored mailbox, actual enquiry/active-pilot retention policy, and
# the pilot_requests database region (not a Vercel edge or visitor region).
PILOT_CONTACT_SUPPORT_EMAIL=
PILOT_CONTACT_RETENTION=
PILOT_CONTACT_HOSTING_REGION=
