# Canonical origin used for metadataBase, sitemap, robots, and social images.
# Production on Vercel is https://sioona-site.vercel.app.
# If unset, the app uses VERCEL_PROJECT_PRODUCTION_URL, then https://sioona-site.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the "Sign In" link points (the product app). Leave unset to link to /contact.
NEXT_PUBLIC_APP_URL=

# Server-only durable pilot intake destination and matching backend service token.
PILOT_INTAKE_BACKEND_URL=
SIOONA_SERVICE_TOKEN=
