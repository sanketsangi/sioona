# REQUIRED for production builds AND runtime. An HTTPS custom-domain origin only.
# Development/test may use http://localhost:3000. Never copy localhost into production.
# Intended cutover: https://sioona.si (configure DNS/TLS and rebuild before launch).
NEXT_PUBLIC_SITE_URL=

# Optional HTTPS product origin. Leave unset for this launch; Sign in is omitted.
# Intended product domain: https://app.sioona.si, only after that app is provisioned.
NEXT_PUBLIC_APP_URL=

# Server-only FastAPI base URL and matching service token. /v1/pilot-requests is appended.
PILOT_INTAKE_BACKEND_URL=
SIOONA_SERVICE_TOKEN=

# Public facts at production build AND runtime. Rebuild on changes.
# Hosting region is required; support email and retention may remain unpublished.
# Actual contact-request retention wording, monitored mailbox and pilot DB region.
# These apply to contact records, not customer exports.
PILOT_CONTACT_SUPPORT_EMAIL=
PILOT_CONTACT_RETENTION=
PILOT_CONTACT_HOSTING_REGION=

# Optional public ownership codes: paste only the content value, never the full meta tag.
# These are build-time HTML metadata; rebuild after changing. Domain-level Google
# verification still requires the DNS TXT record supplied by Search Console.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=

# Operator-generated IndexNow ownership key (8–128 letters, digits or dashes).
# Served at /indexnow-key.txt at runtime. Set the same value for the submission CLI.
# Nothing submits automatically; no API credential belongs in this field.
INDEXNOW_KEY=
