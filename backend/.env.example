# Neon Postgres (preferred for shared pilots).
# Use postgresql+psycopg://… for SQLAlchemy + psycopg v3 (not plain postgresql://).
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Local/dev fallback when Neon is unavailable (file SQLite; auto-creates tables):
# DATABASE_URL=sqlite+pysqlite:///./sioona_local.db

# Required for hosted production; must match the site's server-only token.
SIOONA_ENV=development
SIOONA_SERVICE_TOKEN=
# Global rolling 24-hour cap on new intake records; retries remain accepted.
PILOT_INTAKE_DAILY_LIMIT=1000
