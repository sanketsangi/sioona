# Neon Postgres (preferred for shared pilots).
# Use postgresql+psycopg://… for SQLAlchemy + psycopg v3 (not plain postgresql://).
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# Local/dev fallback when Neon is unavailable (file SQLite; auto-creates tables):
# DATABASE_URL=sqlite+pysqlite:///./sioona_local.db

# CB-11: keep inline until the separately approved processor cutover.
SIOONA_DETECTION_EXECUTION=inline
SIOONA_WORKER_PAUSE=1

# Trusted server/operator allowlist; never derive it from job payloads.
SIOONA_WORKER_TENANTS=
DETECT_LLM=0
DETECT_LLM_PRIMARY=1
DETECT_LLM_MODEL=qwen/qwen3.8-27b
DETECT_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Tenant authorized to update global inference controls under runtime RLS.
SIOONA_GLOBAL_CONTROL_TENANT=
