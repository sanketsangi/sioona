# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Promptfoo signal-detect cache and run output
/.promptfoo/
/eval/signal-detect/results/
promptfoo-errors.log

# next.js
/.next/
/out/

# local runtime store (seeded from fixtures on first run)
/data/store.json

# Day-1 / week-N pilot drop-ins (redacted partner export; never commit real PII)
/data/samples/real-partner-export.local.csv
/data/samples/real-partner-export.week2.local.csv
/data/samples/*.week2.local.csv
/data/samples/real-partner-export.week3.local.csv
/data/samples/*.week3.local.csv
/data/samples/*.local.csv

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Accidental nested app dir (next run from wrong cwd)
/web/
