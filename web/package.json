{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "eval": "node eval/promptfoo/run-eval.mjs",
    "eval:signal": "node eval/promptfoo/run-eval.mjs",
    "eval:signal:injection": "node eval/promptfoo/run-eval.mjs -c promptfooconfig.injection.yaml",
    "eval:signal:smoke": "node eval/promptfoo/run-smoke.mjs",
    "eval:partner-export": "npx tsx src/lib/eval-partner-export.ts",
    "eval:gate": "npx tsx eval/gate/run-gate.ts",
    "eval:gate:record": "npx tsx eval/gate/run-gate.ts --record",
    "ops:week6-keep-set": "npx tsx scripts/week6-keep-set-ops.ts",
    "agent": "npx tsx scripts/cursor-agent.ts",
    "e2e": "node e2e/run-guarded.mjs",
    "eval:holdout": "tsx eval/gate/holdout.ts",
    "eval:holdout:preflight": "tsx eval/gate/holdout.ts --preflight",
    "eval:promotion": "tsx eval/gate/holdout.ts --promotion"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "exceljs": "4.4.0",
    "html-to-text": "10.0.1",
    "postal-mime": "4.0.5",
    "saxes": "5.0.1",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.35",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8",
    "promptfoo": "^0.123.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "@types/html-to-text": "9.0.4"
  }
