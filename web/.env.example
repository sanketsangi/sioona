# FastAPI Signal Score (required for hosted Shadow Mode)
BACKEND_URL=http://localhost:8000

# Skiper UI Pro — required for `npx shadcn add @skiper-ui/*` (e.g. skiper45, skiper86).
# Put the real key in `.env.local` (gitignored). Never commit the key.
# SKIPER_LICENSE_KEY=

# Action Mode (Insights Act queue). Unlocked in local `next dev` by default.
# Prod stays locked unless set to true — still display-only (no outbound send).
# NEXT_PUBLIC_ACTION_MODE_UNLOCKED=true

# Detect v2 — Groq Qwen second pass (optional). Off unless DETECT_LLM=1.
# DETECT_LLM=1
# GROQ_API_KEY=
# DETECT_LLM_MODEL=qwen/qwen3.6-27b
# DETECT_LLM_MAX_CALLS=8
# DETECT_LLM_CONCURRENCY=2
#
# Production (Vercel Hobby ~10s): DETECT_LLM_MAX_CALLS=4 and
# DETECT_LLM_CONCURRENCY=2 so detect + Neon dual-write fit. Groq key
# Production-only; cap spend at $20/mo in the Groq console.

# Sentry (errors, tracing, profiling). DSN is public; auth token is not.
# Set the same DSN + org/project on Vercel for production. Source maps
# upload on `next build` only when SENTRY_AUTH_TOKEN is present.
NEXT_PUBLIC_SENTRY_DSN=https://d49a82e421cba39481529bb4d23ff3af@o4512013087277056.ingest.de.sentry.io/4512013106544720
SENTRY_DSN=https://d49a82e421cba39481529bb4d23ff3af@o4512013087277056.ingest.de.sentry.io/4512013106544720
SENTRY_ORG=sioona
SENTRY_PROJECT=sioona
SENTRY_URL=https://de.sentry.io
# SENTRY_AUTH_TOKEN=
# SENTRY_DEBUG=1
# NEXT_PUBLIC_SENTRY_DEBUG=1
# SENTRY_TEST_TRIGGER=1
