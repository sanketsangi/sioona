# FastAPI Signal Score (required for hosted Shadow Mode)
BACKEND_URL=http://localhost:8000

# Pilot sign-in. Leave unset for local `next dev` (routes stay open).
# Production (NODE_ENV=production or SIOONA_ENV=production) requires AUTH_SECRET.
# AUTH_SECRET=
# SIOONA_SERVICE_TOKEN=
# SIOONA_TENANT_ID=tenant_partner
# SIOONA_ADMIN_EMAIL=
# SIOONA_ADMIN_PASSWORD=
# SIOONA_REVIEWER_EMAIL=
# SIOONA_REVIEWER_PASSWORD=
# SIOONA_PUBLIC_DEMO=1
# SIOONA_ALLOW_DEMO_ACTIONS=1
# SIOONA_ENV=production

# Skiper UI Pro — required for `npx shadcn add @skiper-ui/*` (e.g. skiper45, skiper86).
# Put the real key in `.env.local` (gitignored). Never commit the key.
# SKIPER_LICENSE_KEY=

# Action Mode (Insights Act queue). Unlocked in local `next dev` by default.
# Prod stays locked unless set to true — still display-only (no outbound send).
# NEXT_PUBLIC_ACTION_MODE_UNLOCKED=true

# Detect v2 — Groq Qwen second pass (optional). Off unless DETECT_LLM=1.
# DETECT_LLM=1
# GROQ_API_KEY=
# DETECT_LLM_MODEL=qwen/qwen3.8-27b
#
# Promptfoo signal eval (`npm run eval` from web/): uses GROQ_API_KEY and
# DETECT_LLM_MODEL (defaults to qwen/qwen3.8-27b). Requires Node >= 22.22.
# DETECT_LLM_MAX_CALLS=8
# DETECT_LLM_CONCURRENCY=2
# LLM-first (default when DETECT_LLM=1). Set to 0 to keep the old miss-only pass.
# DETECT_LLM_PRIMARY=1
# Local pilot cap when DETECT_LLM_MAX_CALLS is unset: 120. On Vercel the unset cap stays 8.
# DETECT_LLM_MAX_ATTEMPTS=3
# DETECT_LLM_MIN_INTERVAL_MS=200
# When the primary model hits Groq's daily token cap, the rest of that run
# uses this model. Set to 0 to stay on the primary model only.
# DETECT_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
#
# Production (Vercel Hobby ~10s): DETECT_LLM_MAX_CALLS=4 and
# DETECT_LLM_CONCURRENCY=2 so detect + Neon dual-write fit. Groq key
# Production-only; cap spend at $20/mo in the Groq console.

# Sentry (errors, tracing, profiling). DSN is public; auth token is not.
# Set the same DSN + org/project on Vercel for production. Source maps
# upload on `next build` only when SENTRY_AUTH_TOKEN is present.
NEXT_PUBLIC_SENTRY_DSN=https://d49a82e421cba39481529bb4d23ff3af@o4512013087277056.ingest.de.sentry.io/4512013106544720
SENTRY_DSN=https://d49a82e421cba39481529bb4d23ff3af@o4512013087277056.ingest.de.sentry.io/4512013106544720
SENTRY_ORG=sioona
SENTRY_PROJECT=sioona
SENTRY_URL=https://de.sentry.io
# SENTRY_AUTH_TOKEN=
# SENTRY_DEBUG=1

# Live read-only ingestion. Off unless LIVE_INGEST=1. Never send a customer message.
# LIVE_INGEST=0
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# INTERCOM_ACCESS_TOKEN=
# INTERCOM_WEBHOOK_SECRET=
# WHATSAPP_WEBHOOK_SECRET=
# Webhooks also send X-Sioona-Tenant-Id. It must match SIOONA_TENANT_ID and must not be tenant_demo.
# WHATSAPP_PROVIDER=gupshup
# NEXT_PUBLIC_SENTRY_DEBUG=1
# SENTRY_TEST_TRIGGER=1

# Stable server-only identity key, at least 32 characters. Required for partner ingest in production.
# Set the same secret on every worker; rotation requires an identity migration.
SIOONA_IDENTITY_KEY=

# CB-11 processor cutover: default inline; worker requires canonical Postgres.
SIOONA_DETECTION_EXECUTION=inline
